/target
**/*.rs.bk
*.swp
*.swo
.DS_Store
*.bak
*.toml.bak

# Cargo.lock is intentionally COMMITTED — frp-rs ships binaries, so the lock file
# is part of the reproducible build. It used to be listed here, which was
# misleading (gitignore has no effect on a tracked file) and invited someone to
# "fix" it by untracking the lock.
# scripts/frp-stress/ is a separate throwaway workspace; its lock is not tracked.
scripts/frp-stress/Cargo.lock

# Local tool state and scratch dirs — never part of the repo.
.worktrees/
.claude/
.reasonix/
.superpowers/
# SSH tunnel gateway host key. frps writes this to the CURRENT WORKING DIRECTORY
# by default (`sshTunnelGateway.autoGenPrivateKeyPath` defaults to
# "./.autogen_ssh_key", matching Go frp), so running frps from the repo root
# drops a real private key here. It is a throwaway LOCAL host key — not a
# credential to anything — but it must never be committed. Set
# `auto_gen_private_key_path` to a path outside the repo if you prefer.
.autogen_ssh_key
go-reference/
scripts/frp-stress/target/
.cargo/

# Downloaded Go frp release binaries (scripts/download-go-frp.sh). Never commit
# these: they are platform- and version-specific (~16-20 MB each) and a stale
# copy silently produces meaningless comparisons. compat-test.sh reads them from
# /tmp/frp_<version>_<os>_<arch>/, overridable with GO_FRP_DIR.
scripts/go-frp/frps
scripts/go-frp/frpc
scripts/go-frp/*.toml
