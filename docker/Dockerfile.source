# syntax=docker/dockerfile:1
# Multi-arch source build for frp-rs Docker images.
# Supports linux/amd64, linux/arm64, linux/arm/v7 via cargo-zigbuild.
#
# Pattern: alpine builder → musl-static binary → scratch runtime (~2 MB total).
# Reference: ~/Codes/scripts/docker/frp/Dockerfile
#
# Usage:
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     --build-arg FRP_COMPONENT=frps -f docker/Dockerfile.source .

FROM --platform=$BUILDPLATFORM rust:1-slim-bookworm AS builder
ARG TARGETARCH
ARG FRP_COMPONENT=frps

# Map Docker TARGETARCH to:
#  - Rust target triple (for cargo-zigbuild): musl, fully static
#  - Zig target triple (for zig cc): musl, fully static entrypoint
RUN case "${TARGETARCH}" in \
      amd64) echo "x86_64-unknown-linux-musl"  > /tmp/rust_target ; \
             echo "x86_64-linux-musl"          > /tmp/zig_target  ;; \
      arm64) echo "aarch64-unknown-linux-musl" > /tmp/rust_target ; \
             echo "aarch64-linux-musl"         > /tmp/zig_target  ;; \
      arm)   echo "armv7-unknown-linux-musleabihf" > /tmp/rust_target ; \
             echo "arm-linux-musleabihf"            > /tmp/zig_target  ;; \
      *)     echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libc6-dev curl xz-utils && \
    rm -rf /var/lib/apt/lists/*

# Install zig 0.14.0 (matches release workflow version)
RUN curl -sSfL https://ziglang.org/download/0.14.0/zig-linux-$(uname -m)-0.14.0.tar.xz \
    | tar xJ -C /usr/local && \
    ln -s /usr/local/zig-linux-$(uname -m)-0.14.0/zig /usr/local/bin/zig

# Install cargo-zigbuild (pre-built binary, faster than compiling from source)
RUN ARCH="$(uname -m)" && \
    case "${ARCH}" in \
      x86_64) ZB_TARGET="x86_64-unknown-linux-gnu" ;; \
      aarch64) ZB_TARGET="aarch64-unknown-linux-gnu" ;; \
      *) echo "Unsupported builder arch: ${ARCH}" >&2; exit 1 ;; \
    esac && \
    curl -sSfL "https://github.com/rust-cross/cargo-zigbuild/releases/download/v0.23.0/cargo-zigbuild-${ZB_TARGET}.tar.xz" \
    | tar xJ --strip-components=1 -C /usr/local/cargo/bin && \
    chmod +x /usr/local/cargo/bin/cargo-zigbuild

# Add the cross-compilation target (musl for fully static binary)
RUN rustup target add $(cat /tmp/rust_target)

# Build frp-rs from source
WORKDIR /build
COPY Cargo.toml Cargo.lock* ./
COPY frp-core/ frp-core/
COPY frp-server/ frp-server/
COPY frp-client/ frp-client/
COPY frps/ frps/
COPY frpc/ frpc/

RUN cargo zigbuild --target $(cat /tmp/rust_target) --release && \
    cp target/$(cat /tmp/rust_target)/release/${FRP_COMPONENT} /usr/bin/frp && \
    strip /usr/bin/frp || true

# Cross-compile the C entrypoint — fully static (musl, no libc dep)
COPY docker/entrypoint.c /tmp/entrypoint.c
RUN zig cc -target $(cat /tmp/zig_target) -static -O2 \
    -DFRP_MODE=\"${FRP_COMPONENT}\" -o /entrypoint /tmp/entrypoint.c

# ── Runtime stage ──────────────────────────────────────────
# scratch: 0 MB base. Both frp binary (musl-static) and entrypoint
# (zig-static) have zero runtime deps. Total image ~3 MB.
# Reference: ~/Codes/scripts/docker/frp/Dockerfile
FROM scratch
COPY --from=builder /usr/bin/frp /usr/bin/frp
COPY --from=builder /entrypoint /entrypoint
ENV FRP_CONF=/app/frp.toml
ENTRYPOINT ["/entrypoint"]
